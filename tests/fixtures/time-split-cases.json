    { "name": "no duration gives auto rows nothing", "duration": 0, "minutes": [30, null], "expected": [30, 0] },
    { "name": "all pinned", "duration": 60, "minutes": [30, 30], "expected": [30, 30] },
    { "name": "pinned over the duration leaves auto rows at zero", "duration": 60, "minutes": [45, 45, null], "expected": [45, 45, 0] },
    { "name": "no rows", "duration": 60, "minutes": [], "expected": [] },
    { "name": "single auto row takes the whole duration", "duration": 90, "minutes": [null], "expected": [90] },
    { "name": "pinned row between auto rows", "duration": 10, "minutes": [null, 5, null, null], "expected": [2, 5, 2, 1] }
